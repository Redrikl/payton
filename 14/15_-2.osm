  <tag k="artist_name" v="Садри Ахунов"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="Выполнена известным скульптором Садри Ахуновым в 1935 году. В основе идеи создания скульптуры лежит прославление труда на всем земном шаре."/>
  <tag k="name" v="«Владыкой мира будет труд»"/>
  <tag k="tourism" v="artwork"/>
 </node>
